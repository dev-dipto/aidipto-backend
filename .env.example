# --- server ---
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# --- database ---
# Path to the SQLite file (created automatically)
DATABASE_PATH=./data/aidipto.db

# --- admin login ---
# The admin panel logs in with these. Change the password before deploying.
ADMIN_EMAIL=admin@aidipto.com
ADMIN_PASSWORD=change-this-password
# Random long string — used to sign admin session tokens
JWT_SECRET=replace-with-a-long-random-string
# How long an admin login stays valid
JWT_EXPIRES_IN=12h

# --- optional: AI Automation chat upgrade ---
# Leave empty to use the built-in knowledge-base chat (no external calls, no cost).
# Set this to let Ask AIDIPTO answer with OpenAI instead, grounded in the same knowledge base.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- optional: forward every lead to n8n as well as saving it to the database ---
N8N_WEBHOOK_URL=
